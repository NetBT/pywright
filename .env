# ============================================================
# pywright 默认环境配置（占位值入库，开箱即用）
# 真实敏感值（token/password）请勿写入本文件——用环境变量 TEST_*__* 覆盖（CI masked variables）
# 覆盖顺序：环境变量 TEST_*__* → 本文件 → 代码默认值
# 自定义环境：复制本文件为 .env.{自定义名}（如 .env.uat）并按需修改，运行 --env uat 即可
# ============================================================

# --- 被测应用地址 ---
TEST_APP__UI_BASE_URL=https://demo.playwright.dev/todomvc
TEST_APP__API_BASE_URL=https://httpbin.org

# --- 认证 ---
# mode: api_token | ui_login | reuse
TEST_AUTH__MODE=api_token
TEST_AUTH__TOKEN=placeholder-token
TEST_AUTH__TOKEN_URL=
TEST_AUTH__UI_LOGIN_ENABLED=false
TEST_AUTH__LOGIN_URL=
TEST_AUTH__USERNAME=
TEST_AUTH__PASSWORD=

# --- 浏览器 ---
TEST_BROWSER__DEFAULT_TIMEOUT_MS=10000
